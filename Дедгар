-- ================= ГЛАВНЫЙ ЦИКЛ =================
RunService.RenderStepped:Connect(function()
    FovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FovCircle.Visible = Config.SilentEnabled or Config.AimbotEnabled

    if Config.SilentEnabled or Config.AimbotEnabled then GetTarget() else Target = nil end
    
    if Config.AimbotEnabled and Target and TargetPart then
        local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, TargetPart.Position)
        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.AimSmoothness)
    end

    UpdateESP()
end)

Players.PlayerRemoving:Connect(function(player)
    if ESP_Objects[player] then
        for _, obj in pairs(ESP_Objects[player]) do
            if typeof(obj) == "table" then
                for _, line in pairs(obj) do if line.Remove then line:Remove() end end
            elseif obj.Remove then
                obj:Remove()
            end
        end
        ESP_Objects[player] = nil
    end
end)
